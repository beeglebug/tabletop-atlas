{
  "name": "tabletop-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare deploy",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "latest",
    "@opennextjs/cloudflare": "latest",
    "clsx": "^2.1.1",
    "maplibre-gl": "6.14.0",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "wrangler": "latest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
